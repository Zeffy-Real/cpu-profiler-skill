[Unit]
Description=CPU Profiler API Server
After=network.target cpu-profiler-collector.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m uvicorn src.api.server:app --host 0.0.0.0 --port 8765
WorkingDirectory=/opt/cpu-profiler
Environment=PYTHONUNBUFFERED=1
Environment=DATA_DIR=/var/lib/cpu-profiler
Environment=API_HOST=0.0.0.0
Environment=API_PORT=8765
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cpu-profiler

[Install]
WantedBy=multi-user.target
